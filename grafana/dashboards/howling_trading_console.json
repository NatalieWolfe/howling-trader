      "pluginVersion": "13.2.1",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "howling-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_calc AS (\n  SELECT\n    CASE\n      WHEN '${resolution}' = '1m'  THEN INTERVAL '1 minute'\n      WHEN '${resolution}' = '5m'  THEN INTERVAL '5 minutes'\n      WHEN '${resolution}' = '15m' THEN INTERVAL '15 minutes'\n      WHEN '${resolution}' = '1h'  THEN INTERVAL '1 hour'\n      WHEN '${resolution}' = '1d'  THEN INTERVAL '1 day'\n      ELSE\n        CASE\n          WHEN ($__to - $__from) / 1000 <= 14400   THEN INTERVAL '1 minute'\n          WHEN ($__to - $__from) / 1000 <= 86400   THEN INTERVAL '5 minutes'\n          WHEN ($__to - $__from) / 1000 <= 604800  THEN INTERVAL '1 hour'\n          ELSE INTERVAL '1 day'\n        END\n    END AS step\n),\ncombined_candles AS (\n  SELECT\n    opened_at,\n    open,\n    high,\n    low,\n    close,\n    volume\n  FROM candles\n  WHERE symbol = ${symbol}\n    AND $__timeFilter(opened_at)\n\n  UNION ALL\n\n  SELECT\n    date_trunc('minute', emitted_at) AS opened_at,\n    (array_agg(last ORDER BY emitted_at ASC))[1] AS open,\n    MAX(last) AS high,\n    MIN(last) AS low,\n    (array_agg(last ORDER BY emitted_at DESC))[1] AS close,\n    COALESCE(SUM(last_lots), 0) AS volume\n  FROM market\n  WHERE symbol = ${symbol}\n    AND emitted_at >= date_trunc('minute', NOW())\n    AND to_timestamp($__to / 1000.0) >= date_trunc('minute', NOW())\n    AND last > 0\n    AND NOT EXISTS (\n      SELECT 1 FROM candles\n      WHERE symbol = ${symbol}\n        AND opened_at = date_trunc('minute', NOW())\n    )\n  GROUP BY date_trunc('minute', emitted_at)\n)\nSELECT\n  date_bin(tc.step, c.opened_at, TIMESTAMP '2000-01-01') AS \"time\",\n  (array_agg(c.open ORDER BY c.opened_at ASC))[1] AS \"open\",\n  MAX(c.high) AS \"high\",\n  MIN(c.low) AS \"low\",\n  (array_agg(c.close ORDER BY c.opened_at DESC))[1] AS \"close\",\n  SUM(c.volume) AS \"volume\"\nFROM combined_candles c\nCROSS JOIN time_calc tc\nGROUP BY 1\nORDER BY 1 ASC;",
          "refId": "Candles"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "howling-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.executed_at AS time, CASE WHEN a.name = 'BUY' THEN t.price END AS \"Buy Fill\", CASE WHEN a.name = 'SELL' THEN t.price END AS \"Sell Fill\" FROM trades t JOIN enum_actions a ON t.action = a.id WHERE t.symbol = ${symbol} AND a.name IN ('BUY', 'SELL') AND $__timeFilter(t.executed_at) ORDER BY t.executed_at ASC;",
          "refId": "Trades"
        }
      ],
      "title": "Market & Trades",
      "type": "candlestick"
    },
