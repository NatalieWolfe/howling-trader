          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.executed_at AS \"Executed At\", s.name AS \"Symbol\", a.name AS \"Action\", t.price AS \"Price\", t.quantity AS \"Qty\", (t.price * t.quantity) AS \"Total ($)\", t.confidence AS \"Confidence\", CASE WHEN t.dry_run THEN 'Dry Run' ELSE 'Live' END AS \"Mode\" FROM trades t LEFT JOIN enum_symbols s ON t.symbol = s.id LEFT JOIN enum_actions a ON t.action = a.id WHERE (${symbol} = -1 OR t.symbol = ${symbol}) AND t.executed_at >= date_trunc('day', to_timestamp($__from / 1000.0) AT TIME ZONE 'UTC') AND t.executed_at < date_trunc('day', to_timestamp($__to / 1000.0) AT TIME ZONE 'UTC') + INTERVAL '1 day' ORDER BY t.executed_at DESC LIMIT 100;",
