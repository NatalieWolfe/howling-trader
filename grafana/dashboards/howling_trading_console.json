          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(COUNT(*), 0) AS \"Trades\", COALESCE(SUM(t.quantity), 0) AS \"Volume\", COALESCE(SUM(CASE WHEN a.name = 'SELL' THEN t.quantity * t.price ELSE 0 END), 0) - COALESCE(SUM(CASE WHEN a.name = 'BUY' THEN t.quantity * t.price ELSE 0 END), 0) AS \"$Δ\" FROM trades t JOIN enum_actions a ON t.action = a.id WHERE t.symbol = ${symbol} AND t.executed_at >= date_trunc('day', to_timestamp($__from / 1000.0) AT TIME ZONE 'UTC') AND t.executed_at < date_trunc('day', to_timestamp($__to / 1000.0) AT TIME ZONE 'UTC') + INTERVAL '1 day';",
          "refId": "A"
        }
