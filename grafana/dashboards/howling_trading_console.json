      "id": 5,
      "options": {
        "candleStyle": "candles",
        "colorStrategy": "open-vs-close",
        "colors": {
          "down": "rgb(234, 53, 70)",
          "flat": "rgb(170, 170, 170)",
          "up": "rgb(38, 166, 91)"
        },
        "fields": {
          "close": "close",
          "high": "high",
          "low": "low",
          "open": "open",
          "volume": "volume"
        },
        "includeAbsChange": true,
        "includeRelChange": true,
        "includeVolume": true,
        "mode": "candles+volume",
        "legend": {
