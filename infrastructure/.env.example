# Copy this file to infrastructure/.env and fill in your local secrets.
# infrastructure/.env is gitignored and automatically loaded by docker compose
# when running via infrastructure/local-up.sh or bazel run //infrastructure:local-up.

# Required Schwab API credentials (stored in OpenBao at secret/howling/prod/schwab).
SCHWAB_API_KEY=
SCHWAB_API_SECRET=

# Required Telegram notification credentials (stored in OpenBao at secret/howling/prod/telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required Namecheap API credentials for Caddy Let's Encrypt DNS-01 TLS (den.lupine.farm).
NAMECHEAP_API_KEY=
NAMECHEAP_USER=
# Optional allowlisted client IPv4 for Namecheap API requests. Setting your
# static public IPv4 explicitly is recommended when available (auto-discovered
# via external lookup if omitted).
# NAMECHEAP_CLIENT_IP=

# Optional OpenBao transit backup key.
# BAO_BACKUP_KEY=
