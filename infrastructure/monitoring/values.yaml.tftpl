prometheus:
  fullnameOverride: "prometheus"
  nodeSelector: { nodepool: "monitor-nodepool" }
  tolerations:
    - key: "dedicated"
      value: "monitoring"
      effect: "NoSchedule"
  grafana:
    enabled: true
    fullnameOverride: "grafana"
    persistence:
      enabled: true
      storageClassName: csi-cinder-high-speed
      size: 5Gi
    resources:
      requests: { memory: 512Mi }
      limits: { memory: 1Gi }
    additionalDataSources:
      - name: Loki
        type: loki
        url: http://loki.${namespace}:3100
        access: proxy
  alertmanager:
    enabled: true
    config:
      route: { receiver: "null" }
      receivers:
        - name: "null"
    alertmanagerSpec:
      storage:
        volumeClaimTemplate:
          spec:
            storageClassName: csi-cinder-high-speed
            resources: { requests: { storage: 2Gi } }
      resources:
        requests: { memory: 200Mi }
        limits: { memory: 700Mi }
  kube-state-metrics:
    nodeSelector: { nodepool: "monitor-nodepool" }
    tolerations:
      - key: "dedicated"
        value: "monitoring"
        effect: "NoSchedule"
    resources:
      requests: { memory: 100Mi }
      limits: { memory: 300Mi }
  prometheus:
    prometheusSpec:
      enableRemoteWriteReceiver: true
      retention: 7d
      retentionSize: 45GB
      resources:
        requests: { memory: 4.5Gi }
        limits: { memory: 6Gi }
      storageSpec:
        volumeClaimTemplate:
          spec:
            storageClassName: csi-cinder-high-speed
            resources: { requests: { storage: 50Gi } }

loki:
  fullnameOverride: "loki"
  nodeSelector: { nodepool: "monitor-nodepool" }
  tolerations:
    - key: "dedicated"
      value: "monitoring"
      effect: "NoSchedule"
  loki:
    storage:
      type: s3
      s3:
        endpoint: ${s3_endpoint}
        bucketnames: ${s3_bucket}
        region: ${s3_region}
        s3ForcePathStyle: true
    limits_config: { retention_period: 336h }
  compactor:
    working_directory: /data/retention
    shared_store: s3
    retention_enabled: true
  persistence:
    enabled: true
    storageClass: csi-cinder-high-speed
    size: 20Gi
    mountPath: /data
  resources:
    requests: { memory: 2Gi }
    limits: { memory: 3Gi }

alloy:
  fullnameOverride: "alloy"
  rbac: { create: true }
  nodeSelector: {}
  tolerations: [{ operator: "Exists" }]
  resources:
    requests: { memory: 500Mi }
    limits: { memory: 1Gi }
  controller:
    extraVolumes:
      - name: varlog
        hostPath: { path: /var/log }
      - name: varlibdockercontainers
        hostPath: { path: /var/lib/docker/containers }
    extraVolumeMounts:
      - name: varlog
        mountPath: /var/log
        readOnly: true
      - name: varlibdockercontainers
        mountPath: /var/lib/docker/containers
        readOnly: true
  alloy:
    configContent: |
      discovery.kubernetes "pods" { role = "pod" }

      discovery.relabel "filtered_pods" {
        targets = discovery.kubernetes.pods.targets
        rule {
          source_labels = ["__meta_kubernetes_namespace"]
          regex         = "kube-system|${namespace}"
          action        = "drop"
        }
        rule {
          source_labels = [
            "__meta_kubernetes_pod_container_port_name",
            "__meta_kubernetes_pod_container_port_number",
          ]
          regex         = "(metrics|prometheus|9090|8080|80);.*|.*;(9090|8080|80)"
          action        = "keep"
        }
        rule {
          source_labels = ["__address__", "__meta_kubernetes_pod_container_name"]
          separator     = ";"
          regex         = "(.+);(.+)"
          target_label  = "__tmp_dedup"
          action        = "replace"
        }
        rule {
          source_labels = [
            "__meta_kubernetes_pod_ip",
            "__meta_kubernetes_pod_container_port_number",
          ]
          separator     = ":"
          target_label  = "__address__"
          action        = "replace"
        }
      }

      prometheus.scrape "pods" {
        targets    = discovery.relabel.filtered_pods.targets
        forward_to = [prometheus.remote_write.local.receiver]
      }

      prometheus.remote_write "local" {
        endpoint {
          url = "http://prometheus-operated.${namespace}:9090/api/v1/write"
        }
      }

      loki.source.kubernetes "logs" {
        targets    = discovery.relabel.filtered_pods.targets
        forward_to = [loki.write.local.receiver]
      }

      loki.write "local" {
        endpoint {
          url = "http://loki.${namespace}:3100/loki/api/v1/push"
        }
      }
