module(
    name = "howling-trader",
    version = "1.0",
)

bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_iwyu", version = "0.0.4")
bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.beast", version = "1.90.0.bcr.1")
bazel_dep(name = "boost.url", version = "1.90.0.bcr.1")
bazel_dep(name = "boringssl", version = "0.20261105.0")
bazel_dep(name = "c-ares", version = "1.34.9.bcr.1")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "grpc", version = "1.85.4")
bazel_dep(name = "jsoncpp", version = "1.9.6.bcr.2")
bazel_dep(name = "openssl", version = "0.20261105.0")  # Only openssl bazel_dep
bazel_dep(name = "postgres", version = "16.2.bcr.3")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_shell", version = "0.10.0")
bazel_dep(name = "sqlite3", version = "3.54.1")
bazel_dep(name = "zlib", version = "1.4")

archive_override(
    module_name = "postgres",
    build_file = "//patches:postgres.BUILD",
    integrity = "sha256-K4IBBH7IGs0brSnbonjXiOeJG5w+gjLtoWuyneyBMcc=",
    patch_cmds = [
        "cat <<EOF > MODULE.bazel\nmodule(name = \"postgres\", version = \"16.2.bcr.3\")\nbazel_dep(name = \"rules_cc\", version = \"0.2.4\")\nbazel_dep(name = \"platforms\", version = \"1.0.0\")\nbazel_dep(name = \"bazel_skylib\", version = \"1.8.1\")\nbazel_dep(name = \"boringssl\", version = \"0.20241024.0\")\nbazel_dep(name = \"openssl\", version = \"3.3.1.bcr.6\")\nEOF",
    ],
    patch_strip = 1,
    patches = ["//patches:postgres_boringssl.patch"],
    strip_prefix = "postgresql-16.2",
    urls = ["https://ftp.postgresql.org/pub/source/v16.2/postgresql-16.2.tar.gz"],
)

local_path_override(
    module_name = "openssl",
    path = "patches/openssl_as_boringssl",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "ubuntu_resolute",
    image = "index.docker.io/library/ubuntu",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    tag = "26.04",
)
use_repo(
    oci,
    "ubuntu_resolute",
    "ubuntu_resolute_linux_amd64",
    "ubuntu_resolute_linux_arm64",
)
